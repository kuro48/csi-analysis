# Copy to .env.public (ignored), fill every required value. Never commit secrets.
PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_HTTP_PORT=8080
JWT_SECRET_KEY=
OPERATOR_API_TOKEN=
POSTGRES_PASSWORD=
# Ethereum Sepolia RPC, same network used for contract deployment.
ETHEREUM_RPC_URL=
ONCHAIN_MANIFEST=./backend/contracts/build/onchain/deployment-11155111.json
ONCHAIN_CONFIRMATIONS=3
# Required when adding -f docker-compose.observations.yml:
OBSERVATION_BUILD_DIR=./backend/contracts/build/onchain
OBSERVATION_MANIFEST_FILE=observations-11155111.json
# File path only; the secret is mounted into the signing worker, never the API.
OBSERVATION_RECORDER_KEY_FILE=./.local/observations/recorder.key
OBSERVATION_MAX_TX_WEI=10000000000000000
OBSERVATION_RAW_RETENTION_HOURS=24
