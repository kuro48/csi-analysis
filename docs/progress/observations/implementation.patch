diff --git a/backend/app/services/observation_chain.py b/backend/app/services/observation_chain.py
new file mode 100644
index 0000000..33f6c99
--- /dev/null
+++ b/backend/app/services/observation_chain.py
@@ -0,0 +1,103 @@
+"""Read-only verification of stored breathing proofs against a pinned contract."""
+import json
+from pathlib import Path
+
+from web3 import Web3
+
+from app.core.config import settings
+from app.services.onchain_service import ChainUnavailable
+
+
+def observation_id(capture_id):
+    return Web3.keccak(text="csi-observation:v1:" + capture_id)
+
+
+def patient_ref(patient_id):
+    return Web3.keccak(text="csi-patient:v1:" + patient_id)
+
+
+class ObservationChain:
+    def __init__(self):
+        try:
+            self.manifest = json.loads(Path(settings.OBSERVATION_MANIFEST).read_text())
+            m = self.manifest
+            if (
+                m["kind"] != "breathing-observations"
+                or m["chainId"] not in (11155111, 31337, 1337)
+                or m["circuit"] != "csi_breathing_certificate"
+                or m["publicSignalCount"] != 1
+            ):
+                raise ValueError("Unsupported observation deployment")
+            self.w3 = Web3(Web3.HTTPProvider(settings.ETHEREUM_RPC_URL, request_kwargs={"timeout": 15}))
+            if self.w3.eth.chain_id != m["chainId"]:
+                raise ValueError("Wrong chain")
+            for prefix in ("registry", "verifier"):
+                if Web3.to_hex(Web3.keccak(self.w3.eth.get_code(m[prefix + "Address"]))) != m[prefix + "CodeHash"]:
+                    raise ValueError("Contract code mismatch")
+            self.contract = self.w3.eth.contract(
+                address=Web3.to_checksum_address(m["registryAddress"]), abi=m["registryAbi"]
+            )
+            if (
+                self.contract.functions.recorder().call().lower() != m["recorderAddress"].lower()
+                or self.contract.functions.verifier().call().lower() != m["verifierAddress"].lower()
+                or self.contract.functions.debugMode().call() != m["debugMode"]
+            ):
+                raise ValueError("Deployment configuration mismatch")
+        except Exception as exc:
+            raise ChainUnavailable("呼吸判定の検証先が未設定、またはチェーンに接続できません") from exc
+
+    def metadata(self, capture_id, block="latest"):
+        return self.contract.functions.getObservation(observation_id(capture_id)).call(block_identifier=block)
+
+    def match_metadata(self, job, record):
+        if (
+            record[0] != patient_ref(job["patient_id"])
+            or record[1] != job["observed_at"]
+            or record[2] != job["duration"]
+        ):
+            raise ValueError("患者または計測時刻がチェーン上の記録と一致しません")
+
+    def result(self, job):
+        if (
+            job["chain_id"] != self.manifest["chainId"]
+            or (job["registry"] or "").lower() != self.contract.address.lower()
+        ):
+            raise ValueError("この計測の記録先と現在の設定が一致しません")
+        record = self.metadata(job["id"])
+        if not record[3]:
+            return {"status": "pending"}
+        self.match_metadata(job, record)
+        head = self.w3.eth.block_number
+        confirmations = head - record[3] + 1
+        if confirmations < settings.ONCHAIN_CONFIRMATIONS:
+            return {"status": "confirming", "confirmations": confirmations}
+        # Pin metadata and verifier calls to the same confirmed snapshot.
+        block_number = head - settings.ONCHAIN_CONFIRMATIONS + 1
+        block_hash = self.w3.eth.get_block(block_number)["hash"]
+        stable = self.metadata(job["id"], block_number)
+        if stable != record:
+            raise ChainUnavailable("チェーンの更新中です。再照会してください")
+        try:
+            is_normal = self.contract.functions.verifyObservation(observation_id(job["id"])).call(
+                block_identifier=block_number
+            )
+        except Exception as exc:
+            from web3.exceptions import ContractLogicError
+
+            if isinstance(exc, ContractLogicError) or "revert" in str(exc).lower():
+                raise ValueError("記録された証明を検証できません。判定結果は表示しません") from exc
+            raise
+        if self.w3.eth.get_block(block_number)["hash"] != block_hash:
+            raise ChainUnavailable("チェーンの更新中です。再照会してください")
+        return {
+            "status": "verified",
+            "isNormal": bool(is_normal),
+            "patientId": job["patient_id"],
+            "observedAt": job["observed_at"],
+            "durationSeconds": job["duration"],
+            "verifiedAtBlock": block_number,
+            "confirmations": confirmations,
+            "transactionHash": job["tx_hash"],
+            "chainId": self.manifest["chainId"],
+            "debugInput": self.manifest["debugMode"],
+        }
diff --git a/backend/app/services/observation_store.py b/backend/app/services/observation_store.py
new file mode 100644
index 0000000..67c78af
--- /dev/null
+++ b/backend/app/services/observation_store.py
@@ -0,0 +1,162 @@
+"""Durable single-host capture queue. Proofs persist; raw CSI is temporary."""
+import json
+import os
+import sqlite3
+import time
+from contextlib import contextmanager
+from pathlib import Path
+from uuid import uuid4
+
+from app.core.config import settings
+
+
+class QueueFull(RuntimeError):
+    pass
+
+
+class ObservationStore:
+    def __init__(self):
+        self.root = Path(settings.OBSERVATION_DATA_DIR).resolve()
+        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
+        self.raw = self.root / "raw"
+        self.raw.mkdir(exist_ok=True, mode=0o700)
+        self.path = self.root / "observations.sqlite3"
+        with self.connect() as db:
+            db.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS patients (
+                    id TEXT PRIMARY KEY, label TEXT NOT NULL, created_at INTEGER NOT NULL);
+                CREATE TABLE IF NOT EXISTS captures (
+                    id TEXT PRIMARY KEY, patient_id TEXT NOT NULL REFERENCES patients(id),
+                    observed_at INTEGER NOT NULL, duration INTEGER NOT NULL, digest TEXT NOT NULL,
+                    raw_path TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'queued',
+                    bundle TEXT, tx_hash TEXT, signed_tx TEXT, error TEXT,
+                    chain_id INTEGER, registry TEXT,
+                    attempts INTEGER NOT NULL DEFAULT 0, next_attempt INTEGER NOT NULL DEFAULT 0,
+                    created_at INTEGER NOT NULL);
+                CREATE INDEX IF NOT EXISTS patient_time ON captures(patient_id, observed_at);
+            """
+            )
+        os.chmod(self.path, 0o600)
+
+    @contextmanager
+    def connect(self):
+        db = sqlite3.connect(self.path, timeout=30)
+        db.row_factory = sqlite3.Row
+        db.execute("PRAGMA journal_mode=WAL")
+        db.execute("PRAGMA foreign_keys=ON")
+        try:
+            with db:
+                yield db
+        finally:
+            db.close()
+
+    def patients(self):
+        with self.connect() as db:
+            return [dict(row) for row in db.execute("SELECT * FROM patients ORDER BY created_at, id LIMIT 1000")]
+
+    def add_patient(self):
+        patient_id = str(uuid4())
+        with self.connect() as db:
+            # No names/DOB/medical record numbers are accepted by the public catalog.
+            db.execute("INSERT INTO patients VALUES (?, ?, ?)", (patient_id, "患者 " + patient_id[:8], int(time.time())))
+        return {"id": patient_id, "label": "患者 " + patient_id[:8]}
+
+    def patient_exists(self, patient_id):
+        with self.connect() as db:
+            return db.execute("SELECT 1 FROM patients WHERE id=?", (patient_id,)).fetchone() is not None
+
+    def capture(self, capture_id):
+        with self.connect() as db:
+            row = db.execute("SELECT * FROM captures WHERE id=?", (capture_id,)).fetchone()
+            return dict(row) if row else None
+
+    def enqueue(self, capture_id, patient_id, observed_at, duration, digest, raw_path):
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            existing = db.execute("SELECT 1 FROM captures WHERE id=?", (capture_id,)).fetchone()
+            count = db.execute(
+                "SELECT COUNT(*) FROM captures WHERE status IN ('queued','processing','submitted')"
+            ).fetchone()[0]
+            if not existing and count >= settings.OBSERVATION_MAX_PENDING:
+                raise QueueFull("収集キューが満杯です。後で同じ収集IDで再送してください")
+            db.execute(
+                "INSERT OR IGNORE INTO captures (id,patient_id,observed_at,duration,digest,raw_path,created_at) "
+                "VALUES (?,?,?,?,?,?,?)",
+                (capture_id, patient_id, observed_at, duration, digest, str(raw_path), int(time.time())),
+            )
+            row = dict(db.execute("SELECT * FROM captures WHERE id=?", (capture_id,)).fetchone())
+            if (row["patient_id"], row["observed_at"], row["duration"], row["digest"]) != (
+                patient_id,
+                observed_at,
+                duration,
+                digest,
+            ):
+                raise ValueError("同じ収集IDに異なるデータが指定されています")
+            return row
+
+    def observations(self, patient_id, start_at=0, end_at=253402300799):
+        with self.connect() as db:
+            return [
+                dict(row)
+                for row in db.execute(
+                    "SELECT id,patient_id,observed_at,duration,status FROM captures WHERE patient_id=? "
+                    "AND observed_at>=? AND observed_at<? ORDER BY observed_at DESC, id LIMIT 2000",
+                    (patient_id, start_at, end_at),
+                )
+            ]
+
+    def update(self, capture_id, **fields):
+        allowed = {
+            "status",
+            "bundle",
+            "tx_hash",
+            "signed_tx",
+            "error",
+            "attempts",
+            "next_attempt",
+            "chain_id",
+            "registry",
+        }
+        if not fields or fields.keys() - allowed:
+            raise ValueError("Invalid capture update")
+        with self.connect() as db:
+            db.execute(
+                "UPDATE captures SET " + ",".join(f"{key}=?" for key in fields) + " WHERE id=?",
+                [*fields.values(), capture_id],
+            )
+
+    def next_job(self):
+        with self.connect() as db:
+            # One recorder nonce stream. An uncertain broadcast must settle before
+            # another capture can sign; otherwise a stale RPC nonce could replace it.
+            signed = db.execute(
+                "SELECT * FROM captures WHERE signed_tx IS NOT NULL ORDER BY created_at,id LIMIT 1"
+            ).fetchone()
+            if signed:
+                if signed["status"] == "failed" or signed["next_attempt"] > int(time.time()):
+                    return None
+                return dict(signed)
+            row = db.execute(
+                "SELECT * FROM captures WHERE status IN ('queued','processing','submitted') "
+                "AND next_attempt<=? ORDER BY created_at,id LIMIT 1",
+                (int(time.time()),),
+            ).fetchone()
+            return dict(row) if row else None
+
+    def save_bundle(self, job, bundle):
+        self.update(job["id"], bundle=json.dumps(bundle), status="processing")
+        Path(job["raw_path"]).unlink(missing_ok=True)
+
+    def expire_raw(self):
+        cutoff = int(time.time()) - settings.OBSERVATION_RAW_RETENTION_HOURS * 3600
+        with self.connect() as db:
+            rows = db.execute("SELECT id,raw_path,bundle,status FROM captures WHERE created_at<?", (cutoff,)).fetchall()
+            for row in rows:
+                Path(row["raw_path"]).unlink(missing_ok=True)
+                if row["bundle"] is None and row["status"] in ("queued", "processing"):
+                    db.execute("UPDATE captures SET status='failed',error='raw_expired' WHERE id=?", (row["id"],))
+        # Covers a process crash after upload, before queue commit.
+        for path in self.raw.glob("*.csi"):
+            if path.stat().st_mtime < cutoff:
+                path.unlink(missing_ok=True)
