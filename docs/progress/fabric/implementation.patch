diff --git a/fabric/gateway-server.mjs b/fabric/gateway-server.mjs
new file mode 100644
index 0000000..008ad44
--- /dev/null
+++ b/fabric/gateway-server.mjs
@@ -0,0 +1,82 @@
+import http from "node:http";
+import { readFileSync } from "node:fs";
+import { timingSafeEqual } from "node:crypto";
+import { openGateway } from "./gateway.mjs";
+
+const config = JSON.parse(readFileSync(process.env.FABRIC_GATEWAY_CONFIG));
+const role = process.env.FABRIC_BRIDGE_ROLE;
+const token = process.env.FABRIC_BRIDGE_TOKEN;
+if (!token || token.length < 32)
+  throw new Error("Set a bridge token of at least 32 characters");
+const gateway = openGateway(config, role);
+await gateway.configuration();
+const server = http.createServer(async (req, res) => {
+  res.setHeader("Content-Type", "application/json");
+  res.setHeader("Cache-Control", "no-store");
+  const supplied = Buffer.from(req.headers.authorization || ""),
+    expected = Buffer.from("Bearer " + token);
+  if (
+    supplied.length !== expected.length ||
+    !timingSafeEqual(supplied, expected)
+  ) {
+    res.writeHead(401);
+    res.end("{}");
+    return;
+  }
+  try {
+    let bytes = 0;
+    const parts = [];
+    for await (const chunk of req) {
+      bytes += chunk.length;
+      if (bytes > 20000) throw new Error("Body too large");
+      parts.push(chunk);
+    }
+    const data = parts.length
+      ? JSON.parse(Buffer.concat(parts).toString())
+      : {};
+    let result;
+    if (req.method === "GET" && req.url === "/configuration")
+      result = await gateway.configuration();
+    else if (req.method === "POST" && req.url === "/metadata")
+      result = await gateway.metadata(data.observationId);
+    else if (
+      req.method === "POST" &&
+      req.url === "/verify" &&
+      role === "reader"
+    )
+      result = (await gateway.verify(data.observationId)).result;
+    else if (
+      req.method === "POST" &&
+      req.url === "/record" &&
+      role === "writer"
+    )
+      result = await gateway.record(data);
+    else {
+      res.writeHead(404);
+      res.end("{}");
+      return;
+    }
+    res.end(JSON.stringify(result));
+  } catch (error) {
+    // Do not leak credentials, peer addresses, proof payloads, or gateway errors to callers.
+    console.error("Fabric operation failed:", error.name);
+    res.writeHead(503);
+    res.end(
+      JSON.stringify({
+        error: "Fabric operation failed; no verified result available",
+      }),
+    );
+  }
+});
+server.requestTimeout = 150000;
+server.listen(
+  Number(process.env.FABRIC_BRIDGE_PORT || (role === "reader" ? 8801 : 8802)),
+  process.env.FABRIC_BRIDGE_HOST || "127.0.0.1",
+);
+for (const signal of ["SIGINT", "SIGTERM"])
+  process.on(signal, () =>
+    server.close(() => {
+      gateway.close();
+      process.exit(0);
+    }),
+  );
diff --git a/fabric/gateway.mjs b/fabric/gateway.mjs
new file mode 100644
index 0000000..b480295
--- /dev/null
+++ b/fabric/gateway.mjs
@@ -0,0 +1,114 @@
+import grpc from "@grpc/grpc-js";
+import { connect, hash, signers } from "@hyperledger/fabric-gateway";
+import { createPrivateKey } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+import { createRequire } from "node:module";
+const require = createRequire(import.meta.url);
+const { normalize, proofDigest } = require("./chaincode/lib/proof.js");
+
+export function openGateway(config, role) {
+  const identity = config[role];
+  if (!identity || !["reader", "writer"].includes(role))
+    throw new Error("Missing gateway identity");
+  const client = new grpc.Client(
+    config.peerEndpoint,
+    grpc.credentials.createSsl(readFileSync(config.tlsRootCert)),
+    {
+      "grpc.ssl_target_name_override": config.peerHostAlias,
+      "grpc.default_authority": config.peerHostAlias,
+    },
+  );
+  const gateway = connect({
+    client,
+    identity: {
+      mspId: identity.mspId,
+      credentials: readFileSync(identity.certificate),
+    },
+    signer: signers.newPrivateKeySigner(
+      createPrivateKey(readFileSync(identity.privateKey)),
+    ),
+    hash: hash.sha256,
+    evaluateOptions: () => ({ deadline: Date.now() + 30000 }),
+    endorseOptions: () => ({ deadline: Date.now() + 60000 }),
+    submitOptions: () => ({ deadline: Date.now() + 30000 }),
+    commitStatusOptions: () => ({ deadline: Date.now() + 120000 }),
+  });
+  const contract = gateway
+    .getNetwork(config.channelName)
+    .getContract(config.chaincodeName, "Observations");
+  const decode = (bytes) => JSON.parse(Buffer.from(bytes).toString("utf8"));
+  async function configuration() {
+    const actual = decode(
+      await contract.evaluateTransaction("GetConfiguration"),
+    );
+    if (actual.deploymentId !== config.deploymentId)
+      throw new Error("Fabric deployment mismatch");
+    return actual;
+  }
+  return {
+    config,
+    role,
+    contract,
+    configuration,
+    async metadata(id) {
+      return decode(await contract.evaluateTransaction("ReadObservation", id));
+    },
+    async record(payload) {
+      if (role !== "writer")
+        throw new Error("Reader identity cannot submit observations");
+      const input = normalize(payload);
+      const started = performance.now();
+      const proposal = contract.newProposal("RecordObservation", {
+        arguments: [JSON.stringify(input)],
+      });
+      const transaction = await proposal.endorse();
+      const endorsed = performance.now();
+      const commit = await transaction.submit();
+      const submitted = performance.now();
+      const status = await commit.getStatus();
+      const finished = performance.now();
+      if (!status.successful)
+        throw new Error(`Fabric commit invalid: ${status.code}`);
+      const result = decode(transaction.getResult());
+      if (
+        result.deploymentId !== config.deploymentId ||
+        result.observationId !== input.observationId ||
+        result.proofDigest !== proofDigest(input)
+      )
+        throw new Error("Recorded proof binding mismatch");
+      return {
+        result,
+        commit: {
+          transactionId: status.transactionId,
+          blockNumber: status.blockNumber.toString(),
+          code: status.code,
+        },
+        timings: {
+          endorseMs: endorsed - started,
+          submitMs: submitted - endorsed,
+          commitWaitMs: finished - submitted,
+          recordCommitMs: finished - started,
+        },
+      };
+    },
+    async verify(id) {
+      const started = performance.now();
+      const result = decode(
+        await contract.evaluateTransaction("VerifyObservation", id),
+      );
+      if (
+        result.observationId !== id ||
+        result.status !== "verified" ||
+        typeof result.isNormal !== "boolean" ||
+        result.deploymentId !== config.deploymentId
+      )
+        throw new Error("Invalid verification response");
+      return { result, timings: { verifyReadMs: performance.now() - started } };
+    },
+    close() {
+      gateway.close();
+      client.close();
+    },
+  };
+}
