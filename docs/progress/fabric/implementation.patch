new file mode 100644
index 0000000..8ceef8d
--- /dev/null
+++ b/fabric/test/chaincode.test.mjs
@@ -0,0 +1,145 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createHash, X509Certificate } from "node:crypto";
+import { createRequire } from "node:module";
+const require = createRequire(import.meta.url);
+const Observations = require("../chaincode/lib/observations.js");
+const { normalize, proofDigest } = require("../chaincode/lib/proof.js");
+const cert = readFileSync(new URL("recorder-certificate.txt", import.meta.url));
+const hash = (b) => createHash("sha256").update(b).digest("hex");
+const key = Buffer.from(
+  JSON.stringify({ protocol: "groth16", curve: "bn128", nPublic: 1 }),
+);
+const cfg = {
+  channelName: "csi",
+  readerMspIds: ["Org1MSP", "Org2MSP"],
+  recorderMspId: "Org1MSP",
+  recorderCertificateHash: hash(new X509Certificate(cert).raw),
+  verificationKeyHash: hash(key),
+  deploymentId: "test",
+  debugMode: true,
+};
+const payload = {
+  observationId: "0x" + "1".repeat(64),
+  patientRef: "0x" + "2".repeat(64),
+  observedAt: 1,
+  durationSeconds: 60,
+  proof: {
+    protocol: "groth16",
+    curve: "bn128",
+    pi_a: ["1", "2", "1"],
+    pi_b: [
+      ["1", "2"],
+      ["3", "4"],
+      ["1", "0"],
+    ],
+    pi_c: ["1", "2", "1"],
+  },
+  publicSignals: ["1"],
+};
+function context(msp = "Org1MSP", channel = "csi") {
+  const state = new Map();
+  return {
+    clientIdentity: { getMSPID: () => msp, getIDBytes: () => cert },
+    stub: {
+      getChannelID: () => channel,
+      getTxTimestamp: () => ({ seconds: 100 }),
+      getTxID: () => "a".repeat(64),
+      createCompositeKey: (type, args) => type + args.join(":"),
+      getState: async (k) => state.get(k) || Buffer.alloc(0),
+      putState: async (k, v) => state.set(k, v),
+      setEvent: () => {},
+    },
+    state,
+  };
+}
+test("Record stores no verified flag; metadata and idempotency never disclose output", async () => {
+  const contract = new Observations(cfg, key),
+    ctx = context();
+  const first = JSON.parse(
+    await contract.RecordObservation(
+      ctx,
+      JSON.stringify({ ...payload, rawCSI: "private" }),
+    ),
+  );
+  assert.equal(first.reused, false);
+  assert.equal("isNormal" in first, false);
+  assert.equal(ctx.state.size, 2);
+  assert.equal(
+    [...ctx.state.values()].some((v) => v.includes("private")),
+    false,
+  );
+  const again = JSON.parse(
+    await contract.RecordObservation(ctx, JSON.stringify(payload)),
+  );
+  assert.equal(again.reused, true);
+  assert.equal(again.transactionId, first.transactionId);
+  const metadata = JSON.parse(
+    await contract.ReadObservation(ctx, payload.observationId),
+  );
+  assert.equal("publicSignals" in metadata, false);
+  assert.equal("proof" in metadata, false);
+  await assert.rejects(
+    contract.RecordObservation(
+      ctx,
+      JSON.stringify({ ...payload, durationSeconds: 61 }),
+    ),
+    /Conflicting/,
+  );
+  await assert.rejects(
+    contract.RecordObservation(
+      ctx,
+      JSON.stringify({ ...payload, observationId: "0x" + "3".repeat(64) }),
+    ),
+    /Duplicate/,
+  );
+});
+test("Organization, certificate, channel and time authorization", async () => {
+  const contract = new Observations(cfg, key);
+  await assert.rejects(
+    contract.RecordObservation(context("Org2MSP"), JSON.stringify(payload)),
+    /Unauthorized recorder/,
+  );
+  await assert.rejects(
+    new Observations(
+      { ...cfg, recorderCertificateHash: "bad" },
+      key,
+    ).RecordObservation(context(), JSON.stringify(payload)),
+    /Unauthorized recorder/,
+  );
+  await assert.rejects(
+    contract.ReadObservation(context("Unknown"), payload.observationId),
+    /Unauthorized reader/,
+  );
+  await assert.rejects(
+    contract.ReadObservation(
+      context("Org1MSP", "another"),
+      payload.observationId,
+    ),
+    /Unauthorized reader/,
+  );
+  await assert.rejects(
+    contract.RecordObservation(
+      context(),
+      JSON.stringify({ ...payload, observedAt: 500 }),
+    ),
+    /Future/,
+  );
+  assert.throws(
+    () => new Observations({ ...cfg, verificationKeyHash: "wrong" }, key),
+    /Verification key mismatch/,
+  );
+});
+test("Reject malformed or non-canonical proof fields before storing", () => {
+  assert.throws(() => normalize({ ...payload, publicSignals: ["2"] }));
+  assert.throws(() => normalize({ ...payload, publicSignals: [1] }));
+  assert.throws(() =>
+    normalize({
+      ...payload,
+      proof: { ...payload.proof, pi_a: ["01", "2", "1"] },
+    }),
+  );
+  assert.throws(() => normalize({ ...payload, durationSeconds: 1.5 }));
+  assert.match(proofDigest(normalize(payload)), /^0x[0-9a-f]{64}$/);
+});
diff --git a/fabric/test/metrics.test.mjs b/fabric/test/metrics.test.mjs
new file mode 100644
index 0000000..8e6a05c
--- /dev/null
+++ b/fabric/test/metrics.test.mjs
@@ -0,0 +1,86 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  stats,
+  summarize,
+  allocatedInfrastructure,
+} from "../benchmark/metrics.mjs";
+import { renderReport } from "../benchmark/report.mjs";
+test("Median, nearest-rank p95, and absent values", () => {
+  assert.equal(stats([8, 2, 3, 1]).median, 2.5);
+  assert.equal(stats([8, 2, 3, 1]).p95, 8);
+  assert.deepEqual(stats([null, undefined, NaN, -1]), {
+    n: 0,
+    median: null,
+    p95: null,
+    min: null,
+    max: null,
+  });
+});
+test("Failures counted, warmups excluded, no fake zero measurements", () => {
+  const summary = summarize(
+    [
+      { target: "fabric", warmup: true, status: "verified" },
+      { target: "fabric", status: "failed" },
+    ],
+    "fabric",
+    1,
+  );
+  assert.equal(summary.attempted, 1);
+  assert.equal(summary.failed, 1);
+  assert.equal(summary.metrics.recordCommitMs.median, null);
+  assert.deepEqual(summary.feesWei, []);
+});
+test("Infrastructure cost requires explicit positive workload", () => {
+  assert.equal(allocatedInfrastructure(10, 100), 0.1);
+  assert.throws(() => allocatedInfrastructure(10, 0));
+});
+test("HTML escapes report values and labels absent Sepolia", () => {
+  const html = renderReport({
+    targets: ["fabric"],
+    summaries: [summarize([], "fabric", 1)],
+    rows: [],
+    metadata: { value: "<script>" },
+    inputKind: "<img>",
+    runId: "<script>",
+    warmup: 1,
+    trials: 1,
+  });
+  assert.ok(html.includes("Sepoliaは未計測"));
+  assert.ok(!html.includes("<script>"));
+  assert.ok(!html.includes("<img>"));
+  assert.ok(html.includes("未計測"));
+});
+test("Fees from a committed record remain counted when the later verification fails", () => {
+  const summary = summarize(
+    [
+      {
+        target: "sepolia",
+        status: "failed",
+        cost: { gasUsed: "300000", feeWei: "123" },
+      },
+    ],
+    "sepolia",
+    1,
+  );
+  assert.equal(summary.failed, 1);
+  assert.equal(summary.metrics.recordCommitMs.median, null);
+  assert.deepEqual(summary.feesWei, ["123"]);
+  assert.equal(summary.gasUsed.median, 300000);
+});
+test("A broadcast with unknown receipt is reported as unknown cost", () => {
+  const summary = summarize(
+    [
+      {
+        target: "sepolia",
+        transactionId: "pending",
+        status: "failed",
+        cost: {},
+      },
+    ],
+    "sepolia",
+    1,
+  );
+  assert.equal(summary.unknownFeeCount, 1);
+  assert.deepEqual(summary.feesWei, []);
+});
diff --git a/fabric/test/network.mjs b/fabric/test/network.mjs
new file mode 100644
index 0000000..f9219da
--- /dev/null
+++ b/fabric/test/network.mjs
@@ -0,0 +1,78 @@
+// Opt-in REAL-network integration test; creates records but never resets the ledger.
+import assert from "node:assert/strict";
+import { readFileSync, writeFileSync } from "node:fs";
+import { randomUUID } from "node:crypto";
+import { id } from "ethers";
+import { openGateway } from "../gateway.mjs";
+const config = JSON.parse(readFileSync(process.argv[2]));
+const bank = JSON.parse(readFileSync(process.argv[3]));
+const writer = openGateway(config, "writer"),
+  reader = openGateway(config, "reader");
+const checks = [];
+try {
+  await writer.configuration();
+  await reader.configuration();
+  for (const sample of bank.samples.slice(0, 2)) {
+    const payload = {
+      observationId: id(randomUUID()),
+      patientRef: id(randomUUID()),
+      observedAt: Math.floor(Date.now() / 1000) - 61,
+      durationSeconds: 60,
+      proof: sample.proof,
+      publicSignals: sample.publicSignals,
+    };
+    const record = await writer.record(payload);
+    assert.equal(record.commit.code, 0);
+    assert.equal(record.result.reused, false);
+    assert.equal("isNormal" in record.result, false);
+    const meta = await reader.metadata(payload.observationId);
+    assert.equal("isNormal" in meta, false);
+    assert.equal("publicSignals" in meta, false);
+    const result = await reader.verify(payload.observationId);
+    assert.equal(result.result.isNormal, sample.publicSignals[0] === "1");
+    assert.equal(result.result.transactionId, record.result.transactionId);
+    const repeat = await writer.record(payload);
+    assert.equal(repeat.result.reused, true);
+    assert.equal(repeat.result.transactionId, record.result.transactionId);
+    await assert.rejects(
+      reader.contract.submitTransaction(
+        "RecordObservation",
+        JSON.stringify({ ...payload, observationId: id(randomUUID()) }),
+      ),
+    );
+    await assert.rejects(
+      writer.record({ ...payload, patientRef: id(randomUUID()) }),
+    );
+    await assert.rejects(
+      writer.record({ ...payload, observationId: id(randomUUID()) }),
+    );
+    const tampered = {
+      ...payload,
+      observationId: id(randomUUID()),
+      publicSignals: [sample.publicSignals[0] === "1" ? "0" : "1"],
+    };
+    await writer.record(tampered);
+    await assert.rejects(reader.verify(tampered.observationId));
+    checks.push({
+      isNormal: result.result.isNormal,
+      transactionId: record.result.transactionId,
+      validCommit: true,
+      readerIsOrg2: true,
+      tamperedRejected: true,
+      unauthorizedWriterRejected: true,
+      idempotency: true,
+      replayRejected: true,
+    });
+  }
+  const evidence = {
+    kind: "real-fabric-network-integration",
+    deploymentId: config.deploymentId,
+    checks,
+  };
+  if (process.argv[4])
+    writeFileSync(process.argv[4], JSON.stringify(evidence, null, 2) + "\n");
+  console.log(JSON.stringify(evidence, null, 2));
+} finally {
+  writer.close();
+  reader.close();
+}
