+  await page.goto("/");
+  await expect(page.getByText("Local EVM", { exact: true })).toBeVisible();
+  await page.evaluate(() => window.scrollTo(0, 0));
+  await page.screenshot({
+    path: resolve(evidence, "01-console-desktop.png"),
