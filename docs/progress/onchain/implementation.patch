+                    history.map((item) => (
+                      <tr key={item.hash}>
+                        <td>
+                          <span className={s.txIcon}>↗</span>
+                          <code>{short(item.hash)}</code>
+                        </td>
+                        <td>Chain {item.chainId}</td>
+                        <td>{new Date(item.date).toLocaleString("ja-JP")}</td>
+                        <td>
+                          <button
+                            disabled={
+                              item.chainId !== chain?.chainId ||
+                              item.registry.toLowerCase() !==
+                                chain?.registryAddress?.toLowerCase()
+                            }
+                            onClick={() => {
+                              inspectTransaction(item.hash);
+                            }}
+                          >
+                            チェーンで照会 ↗
+                          </button>
+                        </td>
+                      </tr>
+                    ))
+                  ) : (
+                    <tr>
+                      <td colSpan={4} className={s.empty}>
+                        <Glyph kind="chain" />
+                        <strong>まだ送信した証明はありません</strong>
+                        <span>
+                          最初の証明を送信すると、ここから検証記録を確認できます。
+                        </span>
+                      </td>
+                    </tr>
+                  )}
+                </tbody>
+              </table>
+            </div>
+          </section>
+          <footer className={s.footer}>
+            <span>
+              <span className={s.footerMark}>◈</span> CSI Proof{" "}
+              <span className={s.footerDivider}>/</span> Verifiable sensing
+              infrastructure
+            </span>
+            <Link href="/about">プライバシーと検証範囲 ↗</Link>
+          </footer>
+        </main>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/app/verify/types.ts b/frontend/app/verify/types.ts
new file mode 100644
index 0000000..9860ce5
--- /dev/null
+++ b/frontend/app/verify/types.ts
@@ -0,0 +1,99 @@
+export type Circuit = {
+  name: string;
+  circuitId: string;
+  address: string;
+  publicSignalCount: number;
+  verificationKeyHash: string;
+};
+export type ChainStatus = {
+  connected: boolean;
+  message?: string;
+  chainId?: number;
+  networkName?: string;
+  registryAddress?: string;
+  explorerUrl?: string;
+  currentBlock?: number;
+  totalVerified?: number;
+  confirmationsRequired?: number;
+  circuits: Circuit[];
+};
+export type ProofBundle = {
+  circuit: string;
+  proof: {
+    protocol: string;
+    curve: string;
+    pi_a: string[];
+    pi_b: string[][];
+    pi_c: string[];
+  };
+  publicSignals: string[];
+};
+export type Receipt = {
+  status: "pending" | "confirming" | "confirmed" | "reverted" | "not_found";
+  transactionHash?: string;
+  proofId?: string;
+  blockNumber?: number;
+  confirmations: number;
+  gasUsed?: number;
+  statementHash?: string;
+  submitter?: string;
+};
+export type Prepared = {
+  alreadyVerified: boolean;
+  proofId: string;
+  chainId: number;
+  to: string;
+  data: string;
+  value: string;
+  record?: Receipt;
+};
+
+export function parseBundle(
+  value: unknown,
+  defaultCircuit: string,
+): ProofBundle {
+  if (!value || typeof value !== "object")
+    throw new Error("証明JSONの形式を確認してください。");
+  const object = value as Partial<ProofBundle> & { method?: string };
+  const proof = object.proof;
+  if (
+    !proof ||
+    proof.protocol !== "groth16" ||
+    !["bn128", "bn254"].includes(proof.curve)
+  )
+    throw new Error("Groth16 / BN254形式の証明が必要です。");
+  const decimal = (v: unknown) =>
+    typeof v === "string" && /^(0|[1-9][0-9]{0,77})$/.test(v);
+  if (
+    !Array.isArray(proof.pi_a) ||
+    proof.pi_a.length !== 3 ||
+    !proof.pi_a.every(decimal) ||
+    !Array.isArray(proof.pi_c) ||
+    proof.pi_c.length !== 3 ||
+    !proof.pi_c.every(decimal) ||
+    !Array.isArray(proof.pi_b) ||
+    proof.pi_b.length !== 3 ||
+    !proof.pi_b.every(
+      (row) => Array.isArray(row) && row.length === 2 && row.every(decimal),
+    ) ||
+    !Array.isArray(object.publicSignals) ||
+    !object.publicSignals.length ||
+    object.publicSignals.length > 256 ||
+    !object.publicSignals.every(decimal)
+  ) {
+    throw new Error("証明の座標と公開入力は10進数の文字列で指定してください。");
+  }
+  return {
+    circuit:
+      object.circuit ||
+      (object.method ? `csi_${object.method}` : defaultCircuit),
+    proof: {
+      protocol: proof.protocol,
+      curve: proof.curve,
+      pi_a: proof.pi_a,
+      pi_b: proof.pi_b,
+      pi_c: proof.pi_c,
+    },
+    publicSignals: object.publicSignals,
+  };
+}
