+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { deploymentNetwork, sepoliaEnvironment } from '../scripts/networks.mjs';
+
+test('testnet policy rejects mainnet and unknown chains before connecting', () => {
+  for (const chainId of [1, 10, 137, 8453, 42161, 0, NaN, '11155111']) {
+    assert.throws(() => deploymentNetwork(chainId), /Only Ethereum Sepolia/);
+  }
+  assert.equal(deploymentNetwork(11155111).name, 'Ethereum Sepolia');
+  assert.equal(deploymentNetwork(31337).local, true);
+  assert.equal(deploymentNetwork(1337).local, true);
+});
+
+test('Sepolia entrypoint pins the chain without silently overriding another target', () => {
+  assert.throws(() => sepoliaEnvironment({ ONCHAIN_CHAIN_ID: '1' }), /11155111/);
+  assert.equal(sepoliaEnvironment({}).ONCHAIN_CHAIN_ID, '11155111');
+  assert.equal(sepoliaEnvironment({}).ONCHAIN_EXPLORER_URL, 'https://sepolia.etherscan.io');
+  assert.equal(sepoliaEnvironment({ ETHEREUM_RPC_URL: 'https://rpc.example' }).ETHEREUM_RPC_URL, 'https://rpc.example');
+});
diff --git a/backend/app/services/onchain_service.py b/backend/app/services/onchain_service.py
new file mode 100644
index 0000000..4e0d880
--- /dev/null
+++ b/backend/app/services/onchain_service.py
@@ -0,0 +1,180 @@
+"""Read-only RPC adapter for the immutable registry. Wallets sign transactions.
+
+No private keys, server-paid transactions, or legacy verification flags are used.
+"""
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+from eth_abi import encode
+from web3 import Web3
+from web3.exceptions import TransactionNotFound
+
+from app.core.config import settings
+
+SCALAR_FIELD = 21888242871839275222246405745257275088548364400416034343698204186575808495617
+BASE_FIELD = 21888242871839275222246405745257275088696311157297823662689037894645226208583
+
+
+class ChainUnavailable(RuntimeError):
+    pass
+
+
+def decimal(value: Any, modulus: int) -> int:
+    # JSON numbers cannot safely represent field elements in a browser.
+    if not isinstance(value, str) or not re.fullmatch(r"0|[1-9][0-9]{0,77}", value):
+        raise ValueError("Field elements must be canonical decimal strings")
+    number = int(value)
+    if number >= modulus:
+        raise ValueError("Field element out of range")
+    return number
+
+
+def parse_proof(proof: dict, public_signals: list[str], count: int):
+    if proof.get("protocol") != "groth16" or proof.get("curve") not in ("bn128", "bn254"):
+        raise ValueError("Only Groth16 / BN254 proofs are supported")
+    if len(public_signals) != count:
+        raise ValueError("Public signal count does not match the deployed circuit")
+    try:
+        pa, pb, pc = proof["pi_a"], proof["pi_b"], proof["pi_c"]
+        if (
+            not all(isinstance(point, list) for point in (pa, pb, pc))
+            or len(pa) != 3
+            or len(pb) != 3
+            or len(pc) != 3
+            or any(not isinstance(row, list) or len(row) != 2 for row in pb)
+        ):
+            raise ValueError("Invalid proof dimensions")
+        if pa[2] != "1" or pc[2] != "1" or pb[2] != ["1", "0"]:
+            raise ValueError("Expected affine snarkjs proof")
+        a = [decimal(v, BASE_FIELD) for v in pa[:2]]
+        b = [[decimal(row[1], BASE_FIELD), decimal(row[0], BASE_FIELD)] for row in pb[:2]]
+        c = [decimal(v, BASE_FIELD) for v in pc[:2]]
+    except (KeyError, TypeError, IndexError) as exc:
+        raise ValueError("Invalid Groth16 proof shape") from exc
+    return a, b, c, [decimal(v, SCALAR_FIELD) for v in public_signals]
+
+
+class OnchainService:
+    def __init__(self):
+        if not settings.ONCHAIN_MANIFEST:
+            raise ChainUnavailable("検証コントラクトが未設定です")
+        try:
+            self.manifest = json.loads(Path(settings.ONCHAIN_MANIFEST).read_text())
+            if self.manifest.get("chainId") not in (11155111, 31337, 1337):
+                raise ChainUnavailable("現在はEthereum SepoliaとローカルEVMのみ利用できます")
+            self.w3 = Web3(Web3.HTTPProvider(settings.ETHEREUM_RPC_URL, request_kwargs={"timeout": 10}))
+            if self.w3.eth.chain_id != self.manifest["chainId"]:
+                raise ChainUnavailable("RPCのネットワークが設定と一致しません")
+            address = Web3.to_checksum_address(self.manifest["registryAddress"])
+            if Web3.to_hex(Web3.keccak(self.w3.eth.get_code(address))) != self.manifest["registryCodeHash"]:
+                raise ChainUnavailable("デプロイ済みコントラクトのコードが一致しません")
+            self.contract = self.w3.eth.contract(address=address, abi=self.manifest["registryAbi"])
+            self.circuits = {c["name"]: c for c in self.manifest["circuits"]}
+            for circuit in self.circuits.values():
+                actual = self.contract.functions.circuits(bytes.fromhex(circuit["circuitId"][2:])).call()
+                expected = (
+                    circuit["address"],
+                    bytes.fromhex(circuit["selector"][2:]),
+                    circuit["publicSignalCount"],
+                    bytes.fromhex(circuit["verificationKeyHash"][2:]),
+                    bytes.fromhex(circuit["codeHash"][2:]),
+                )
+                if tuple(actual) != expected:
+                    raise ChainUnavailable("検証回路の設定が一致しません")
+        except ChainUnavailable:
+            raise
+        except Exception as exc:
+            raise ChainUnavailable("ブロックチェーンに接続できません") from exc
+
+    def status(self):
+        return {
+            "connected": True,
+            "chainId": self.manifest["chainId"],
+            "networkName": self.manifest["networkName"],
+            "registryAddress": self.contract.address,
+            "explorerUrl": self.manifest.get("explorerUrl", ""),
+            "currentBlock": self.w3.eth.block_number,
+            "totalVerified": self.contract.functions.totalVerified().call(),
+            "confirmationsRequired": settings.ONCHAIN_CONFIRMATIONS,
+            "circuits": list(self.circuits.values()),
+        }
+
+    def prepare(self, circuit_name: str, proof: dict, public_signals: list[str]):
+        circuit = self.circuits.get(circuit_name)
+        if circuit is None:
+            raise ValueError("この回路の検証コントラクトはデプロイされていません")
+        a, b, c, signals = parse_proof(proof, public_signals, circuit["publicSignalCount"])
+        circuit_id = bytes.fromhex(circuit["circuitId"][2:])
+        proof_id = Web3.to_hex(
+            Web3.keccak(
+                encode(
+                    ["bytes32", "uint256[2]", "uint256[2][2]", "uint256[2]", "uint256[]"],
+                    [circuit_id, a, b, c, signals],
+                )
+            )
+        )
+        existing = self.record(proof_id)
+        if existing["exists"]:
+            return {"alreadyVerified": True, "proofId": proof_id, "record": existing}
+        function = self.contract.functions.verifyAndRecord(circuit_id, a, b, c, signals)
+        # Simulation runs the exact contract path. It does NOT create a verified record.
+        try:
+            function.call({"from": "0x0000000000000000000000000000000000000001"})
+        except Exception as exc:
+            from web3.exceptions import ContractLogicError
+
+            if isinstance(exc, ContractLogicError) or "revert" in str(exc).lower():
+                raise ValueError("証明が検証コントラクトで拒否されました") from exc
+            raise ChainUnavailable("送信前検証に失敗しました。接続を確認してください") from exc
+        return {
+            "alreadyVerified": False,
+            "proofId": proof_id,
+            "chainId": self.manifest["chainId"],
+            "to": self.contract.address,
+            "data": function._encode_transaction_data(),
+            "value": "0x0",
+        }
+
+    def record(self, proof_id: str):
+        record = self.contract.functions.records(bytes.fromhex(proof_id[2:])).call()
+        exists = record[2] != "0x0000000000000000000000000000000000000000"
+        confirmations = max(0, self.w3.eth.block_number - record[4] + 1) if exists else 0
+        return {
+            "proofId": proof_id,
+            "exists": exists,
+            "circuitId": Web3.to_hex(record[0]),
+            "statementHash": Web3.to_hex(record[1]),
+            "submitter": record[2],
+            "timestamp": record[3],
+            "blockNumber": record[4],
+            "confirmations": confirmations,
+            "status": ("confirmed" if confirmations >= settings.ONCHAIN_CONFIRMATIONS else "confirming")
+            if exists
+            else "not_found",
+        }
+
+    def receipt(self, tx_hash: str):
+        try:
+            receipt = self.w3.eth.get_transaction_receipt(tx_hash)
+        except TransactionNotFound:
+            return {"status": "pending", "transactionHash": tx_hash, "confirmations": 0}
+        if not receipt["to"] or receipt["to"].lower() != self.contract.address.lower():
+            raise ValueError("この検証コントラクトへのトランザクションではありません")
+        if receipt["status"] != 1:
+            return {"status": "reverted", "transactionHash": tx_hash, "confirmations": 0}
+        block = self.w3.eth.get_block(receipt["blockNumber"])
+        if block["hash"] != receipt["blockHash"]:
+            return {"status": "pending", "transactionHash": tx_hash, "confirmations": 0}
+        logs = self.contract.events.ProofVerified().process_receipt(receipt)
+        logs = [log for log in logs if log["address"].lower() == self.contract.address.lower()]
+        if len(logs) != 1:
+            raise ValueError("検証成功イベントが見つかりません")
+        record = self.record(Web3.to_hex(logs[0]["args"]["proofId"]))
+        return {
+            **record,
+            "transactionHash": tx_hash,
+            "gasUsed": receipt["gasUsed"],
+            "blockHash": Web3.to_hex(receipt["blockHash"]),
+        }
diff --git a/backend/tests/unit/test_onchain.py b/backend/tests/unit/test_onchain.py
new file mode 100644
index 0000000..dca083d
--- /dev/null
+++ b/backend/tests/unit/test_onchain.py
@@ -0,0 +1,163 @@
+import copy
+import io
+import json
+from types import SimpleNamespace
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from starlette.datastructures import UploadFile
+
+from app.api.endpoints import onchain
+from app.api.endpoints.breathing import _read_upload
+from app.core.access import require_operator
+from app.core.config import settings
+from app.services.onchain_service import BASE_FIELD, SCALAR_FIELD, ChainUnavailable, OnchainService, parse_proof
+
+
+@pytest.mark.parametrize("chain_id", [1, 10, 8453, 42161, 0])
+def test_mainnet_manifest_rejected_before_rpc(monkeypatch, tmp_path, chain_id):
+    path = tmp_path / "deployment.json"
+    path.write_text(json.dumps({"chainId": chain_id}))
+    monkeypatch.setattr(settings, "ONCHAIN_MANIFEST", str(path))
+    with pytest.raises(ChainUnavailable, match="Sepolia"):
+        OnchainService()
+
+PROOF = {
+    "protocol": "groth16",
+    "curve": "bn128",
+    "pi_a": ["1", "2", "1"],
+    "pi_b": [["3", "4"], ["5", "6"], ["1", "0"]],
+    "pi_c": ["7", "8", "1"],
+}
+
+
+def test_snarkjs_pair_order_and_signal_precision():
+    a, b, c, signals = parse_proof(PROOF, [str(SCALAR_FIELD - 1)], 1)
+    assert (a, b, c) == ([1, 2], [[4, 3], [6, 5]], [7, 8])
+    assert signals == [SCALAR_FIELD - 1]
+
+
+@pytest.mark.parametrize("signal", ["-1", "01", "1.5", "1e3", str(SCALAR_FIELD), 1, True, None])
+def test_invalid_public_fields(signal):
+    with pytest.raises(ValueError):
+        parse_proof(PROOF, [signal], 1)
+
+
+def test_invalid_coordinate_and_arity():
+    proof = copy.deepcopy(PROOF)
+    proof["pi_a"][0] = str(BASE_FIELD)
+    with pytest.raises(ValueError):
+        parse_proof(proof, ["1"], 1)
+    with pytest.raises(ValueError):
+        parse_proof(PROOF, ["1", "2"], 1)
+    proof["pi_a"] = "121"
+    with pytest.raises(ValueError):
+        parse_proof(proof, ["1"], 1)
+
+
+@pytest.fixture
+def api():
+    app = FastAPI()
+    app.include_router(onchain.router, prefix="/onchain")
+    with TestClient(app) as client:
+        yield client, app
+
+
+def test_unconfigured_status_does_not_expose_rpc(api, monkeypatch):
+    monkeypatch.setattr(settings, "ONCHAIN_MANIFEST", "")
+    client, _ = api
+    response = client.get("/onchain/status")
+    assert response.status_code == 200
+    assert response.json()["connected"] is False
+    assert "rpc" not in response.text.lower()
+
+
+def test_api_prepare_validation_and_receipt(api):
+    client, app = api
+
+    class Service:
+        def prepare(self, circuit, proof, signals):
+            parse_proof(proof, signals, 1)
+            return {"proofId": "0x" + "a" * 64, "alreadyVerified": False, "value": "0x0"}
+
+        def receipt(self, tx_hash):
+            return {"transactionHash": tx_hash, "status": "pending", "confirmations": 0}
+
+    app.dependency_overrides[onchain.get_onchain_service] = Service
+    response = client.post(
+        "/onchain/prepare", json={"circuit": "csi_breathing_certificate", "proof": PROOF, "publicSignals": ["1"]}
+    )
+    assert response.status_code == 200
+    assert response.json()["value"] == "0x0"
+    response = client.post(
+        "/onchain/prepare", json={"circuit": "csi_breathing_certificate", "proof": PROOF, "publicSignals": ["-1"]}
+    )
+    assert response.status_code == 422
+    assert client.get("/onchain/transactions/invalid").status_code == 422
+    response = client.get("/onchain/transactions/0x" + "a" * 64)
+    assert response.status_code == 200
+    assert response.json()["status"] == "pending"
+
+
+def test_private_research_routes_require_token(monkeypatch):
+    from fastapi import Depends
+
+    monkeypatch.setattr(settings, "PUBLIC_MODE", True)
+    monkeypatch.setattr(settings, "OPERATOR_API_TOKEN", "a" * 40)
+    app = FastAPI()
+
+    @app.get("/research", dependencies=[Depends(require_operator)])
+    def research():
+        return {"ok": True}
+
+    with TestClient(app) as client:
+        assert client.get("/research").status_code == 401
+        assert client.get("/research", headers={"Authorization": "Bearer wrong"}).status_code == 401
+        assert client.get("/research", headers={"Authorization": "Bearer " + "a" * 40}).json() == {"ok": True}
+
+
+@pytest.mark.asyncio
+async def test_streamed_upload_rejects_over_limit(monkeypatch):
+    from fastapi import HTTPException
+
+    from app.api.endpoints import breathing
+
+    monkeypatch.setattr(breathing, "MAX_ANALYSIS_BYTES", 3)
+    with pytest.raises(HTTPException) as error:
+        await _read_upload(UploadFile(file=io.BytesIO(b"1234"), filename="sample.csi"))
+    assert error.value.status_code == 413
+
+
+def test_receipt_requires_correct_contract_event_canonical_block_and_confirmations(monkeypatch):
+    monkeypatch.setattr(settings, "ONCHAIN_CONFIRMATIONS", 3)
+    address = "0x" + "a" * 40
+    proof_id = b"p" * 32
+    receipt = {"to": address, "status": 1, "blockNumber": 10, "blockHash": b"b" * 32, "gasUsed": 340000}
+    logs = [{"address": address, "args": {"proofId": proof_id}}]
+    eth = SimpleNamespace(
+        block_number=11, get_transaction_receipt=lambda _: receipt, get_block=lambda _: {"hash": b"b" * 32}
+    )
+    record = [b"c" * 32, b"s" * 32, "0x" + "1" * 40, 12345, 10]
+    service = OnchainService.__new__(OnchainService)
+    service.w3 = SimpleNamespace(eth=eth)
+    service.contract = SimpleNamespace(
+        address=address,
+        events=SimpleNamespace(ProofVerified=lambda: SimpleNamespace(process_receipt=lambda _: logs)),
+        functions=SimpleNamespace(records=lambda _: SimpleNamespace(call=lambda: record)),
+    )
+    assert service.receipt("tx")["status"] == "confirming"
+    eth.block_number = 12
+    assert service.receipt("tx")["status"] == "confirmed"
+    receipt["status"] = 0
