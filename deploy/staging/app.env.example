# Copy to /srv/csi/config/compose.env. Paths are on the APPLICATION host.
RELEASE_TAG=staging-v1
PUBLIC_DOMAIN=csi.home.arpa
ACME_EMAIL=operator@example.invalid
API_ENV_FILE=/srv/csi/config/api.env
WORKER_ENV_FILE=/srv/csi/config/worker.env
DATABASE_ENV_FILE=/srv/csi/config/database.env
DEPLOYMENT_DIR=/srv/csi/deployments
ARTIFACT_DIR=/srv/csi/artifacts
BRIDGE_CA_FILE=/srv/csi/trust/bridges-ca.crt
RECORDER_KEY_FILE=/srv/csi/secrets/recorder.key
# Provisional cap for this 16GB Mac; measure peak RSS and Docker VM memory before proof runs.
WORKER_MEMORY_LIMIT=12g
